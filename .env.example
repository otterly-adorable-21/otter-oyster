# Copy to .env and fill in. Never commit .env.

# Where the site lives. Used in sign-in emails and share links.
APP_URL=http://localhost:3000

# Where uploaded images are stored (a folder that persists between restarts).
DATA_DIR=./data

# Email for sign-in links. If SMTP_HOST is empty, the link is printed in the server log instead (good for testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Otter & Oyster <no-reply@example.com>"

# Comma separated emails allowed to open /admin (reports and takedowns).
ADMIN_EMAILS=

# Discord roles (optional). From your app at https://discord.com/developers/applications
# CLIENT_ID and CLIENT_SECRET are under OAuth2; the BOT_TOKEN is under Bot (press Reset Token to see it).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# How often every role is re-checked, in minutes (at least 5). Payments update roles straight away regardless.
DISCORD_SYNC_MINUTES=30
