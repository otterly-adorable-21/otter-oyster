# Copy to .env and fill in. Never commit .env.

# Where the site lives. Used in sign-in emails and share links.
APP_URL=http://localhost:3000


# Where uploaded images are stored (a folder that persists between restarts).
DATA_DIR=./data

# Email for sign-in links. If SMTP_HOST is empty, the link is printed in the server log instead (good for testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Otter & Oyster <no-reply@example.com>"

# Gank webhook. Put the same value in the webhook URL you register with Gank: /api/webhooks/gank?key=THIS
GANK_WEBHOOK_SECRET=change-me-to-a-long-random-string
# If Gank signs its webhooks, fill both (name of the header and the shared secret). Leave empty if it does not.
GANK_SIGNATURE_HEADER=
GANK_SIGNING_SECRET=
# Hosts allowed for creators' Gank page links (comma separated, subdomains included). Check Gank's real domain.
GANK_ALLOWED_HOSTS=ganknow.com

# Comma separated emails allowed to open /admin (reports and takedowns).
ADMIN_EMAILS=
